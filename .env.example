# Copy to .env and fill in. Never commit the real .env.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://fcrm:fcrm@localhost:5432/fcrm_workbench
POSTGRES_USER=fcrm
POSTGRES_PASSWORD=fcrm
POSTGRES_DB=fcrm_workbench

# --- Model providers (agents in src/agents/, see ai-guidelines.md for which agent uses which) ---
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
JWT_SECRET=change-me
ENV=development

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Vector store (pgvector runs inside the same Postgres instance above) ---
EMBEDDING_MODEL=text-embedding-3-small
